# Application Environment (development | production | staging | test)
NODE_ENV="development"
PORT=3000

# Database connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword123@localhost:5433/car_rental?schema=public"

# Redis connection URL (Required in production: redis:// or rediss://)
REDIS_URL="redis://localhost:6379"

# Allowed CORS Origins (comma-separated, NO wildcard '*' in production)
# Example: "https://admin.drivego.in,https://vendor.drivego.in,https://drivego.in"
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://localhost:8085,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:8085,http://127.0.0.1:3000"

# JWT configuration secrets & parameters (MUST be >= 32 characters in production)
JWT_ACCESS_SECRET="dev_access_secret_key_change_me_12345!"
JWT_REFRESH_SECRET="dev_refresh_secret_key_change_me_12345!"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# SMS OTP Provider Configuration (MSG91 for production delivery)
# In development: SMS_PROVIDER="mock" logs OTPs to local console
# In production: SMS_PROVIDER="msg91" with real MSG91 credentials is required
SMS_PROVIDER="mock"
MSG91_AUTH_KEY="placeholder_msg91_auth_key"
MSG91_TEMPLATE_ID="placeholder_template_id"
MSG91_SENDER_ID="DRIVGO"

# Razorpay API Credentials (RAZORPAY_USE_MOCK must be false in production)
RAZORPAY_KEY_ID="rzp_test_placeholderKeyId"
RAZORPAY_KEY_SECRET="placeholderKeySecret"
RAZORPAY_WEBHOOK_SECRET="placeholderWebhookSecret"
RAZORPAY_USE_MOCK="true"

# Cloudflare R2 (S3-Compatible Object Storage)
R2_USE_MOCK="true"
R2_ACCESS_KEY_ID="mock_access_key"
R2_SECRET_ACCESS_KEY="mock_secret_key"
R2_BUCKET_NAME="drivego-uploads"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-placeholder.r2.dev"
