  category            String
  changeType          String
  environment         String    @default("SANDBOX")
  actorId             String
  actorRole           String
  reason              String?
  beforeSnapshot      Json?
  afterSnapshot       Json?
  createdAt           DateTime  @default(now())

  @@index([providerId, category])
  @@index([changeType])
  @@index([actorId])
  @@index([createdAt])
}

model ProviderRoutingPolicy {
  id                  String    @id @default(cuid())
  policyId            String    @unique
  name                String
  category            String
  tenantScope         String    @default("PLATFORM")
  scopeId             String?
  strategy            String    @default("PRIORITY")
  primaryProviderId   String
  fallbackChain       Json
  weights             Json?
  rules               Json?
  isActive            Boolean   @default(true)
