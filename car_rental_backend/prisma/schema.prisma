datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPORT_AGENT
}

enum BusinessType {
  INDIVIDUAL
  CONSULTANCY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SubscriptionTier {
  BASIC
  PRO
}

enum DocumentType {
  RC_BOOK
  TRADE_LICENSE
  INSURANCE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CarCategory {
  HATCHBACK
  SEDAN
  SUV
  LUXURY
  TEMPO_TRAVELLER
  MINI_BUS
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
}

enum TripType {
  LOCAL
  OUTSTATION
  AIRPORT_TRANSFER
  SELF_DRIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  NONE
  PENDING
  PROCESSED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
}

enum HandoverOtpType {
  PICKUP
  RETURN
}

enum SecurityDepositStatus {
  REQUIRED
  HELD
  REFUNDED
  PARTIALLY_REFUNDED
  FORFEITED
  CANCELLED
}

enum DamageClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id               String            @id @default(cuid())
  name             String
  phone            String            @unique
  email            String?
  role             Role
  passwordHash     String?
  profilePhotoUrl  String?
  banned           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fcmToken         String?
  vendor           Vendor?
  bookings         Booking[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  wishlists        Wishlist[]
  recentlyViewed   RecentlyViewed[]
  auditLogs        AuditLog[]
  disputesRaised   Dispute[]
  disputeEvidences DisputeEvidence[]
  inspections      Inspection[]
  handoverOtpsReceived HandoverOtp[]
  couponUsages     CouponUsage[]

  @@index([phone])
  @@index([role])
}

model Vendor {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  ownerName          String
  city               String
  locality           String?
  latitude           Float?
  longitude          Float?
  gstNumber          String?
  panNumber          String?
  bankDetails        String? // Plain text or JSON
  businessType       BusinessType
  yearsInOperation   Int?
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(0)
  isSponsored        Boolean            @default(false)
  boostExpiresAt     DateTime?
  branchOfId         String?
  branchOf           Vendor?            @relation("VendorBranches", fields: [branchOfId], references: [id], onDelete: SetNull)
  branches           Vendor[]           @relation("VendorBranches")
  subscriptionTier   SubscriptionTier   @default(BASIC)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          Document[]
  cars               Car[]
  bookings           Booking[]
  payouts            Payout[]
  damageClaims       DamageClaim[]

  @@index([city])
  @@index([verificationStatus])
  @@index([branchOfId])
}

model Document {
  id         String         @id @default(cuid())
  vendorId   String
  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  carId      String?
  car        Car?           @relation(fields: [carId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  uploadedAt DateTime       @default(now())

  @@index([vendorId])
  @@index([carId])
  @@index([type])
}

model Car {
  id                     String           @id @default(cuid())
  vendorId               String
  vendor                 Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  make                   String
  model                  String
  year                   Int
  type                   CarCategory
  fuelType               FuelType
  seating                Int
  isAC                   Boolean
  registrationNumber     String
  photos                 String[]
  pricePerKm             Decimal          @db.Decimal(10, 2)
  pricePerDay            Decimal          @db.Decimal(10, 2)
  pricePerHour           Decimal          @db.Decimal(10, 2)
  weeklyDiscountPercent  Float?           @default(0)
  monthlyDiscountPercent Float?           @default(0)
  isAvailable            Boolean          @default(true)
  availableTripTypes     String[] // String[] representation of TripType enum values
  blockedDates           DateTime[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  documents              Document[]
  bookings               Booking[]
  wishlists              Wishlist[]
  recentlyViewed         RecentlyViewed[]

  @@index([vendorId])
  @@index([type])
  @@index([isAvailable])
}

model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  carId              String
  car                Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  tripType           TripType
  pickupLocation     String
  dropLocation       String?
  startDate          DateTime
  endDate            DateTime
  distanceKm         Decimal?      @db.Decimal(10, 2)
  baseFare           Decimal       @db.Decimal(10, 2)
  platformFee        Decimal       @db.Decimal(10, 2)
  gstAmount          Decimal       @db.Decimal(10, 2)
  totalFare          Decimal       @db.Decimal(10, 2)
  netToVendor        Decimal       @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  cancellationFee    Decimal?      @db.Decimal(10, 2)
  refundAmount       Decimal?      @db.Decimal(10, 2)
  cancelledAt        DateTime?
  cancelledBy        String?
  disputeFlag        Boolean       @default(false)
  disputeNote        String?
  driverIncluded     Boolean       @default(true)
  childSeat          Boolean       @default(false)
  extraLuggage       Boolean       @default(false)
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  discountAmount     Decimal?      @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  review             Review?
  payment            Payment?
  dispute            Dispute?
  inspections        Inspection[]
  handoverOtps       HandoverOtp[]
  securityDeposit    SecurityDeposit?
  damageClaims       DamageClaim[]
  couponUsage        CouponUsage?

  @@index([customerId])
  @@index([vendorId])
  @@index([carId])
  @@index([status])
  @@index([carId, startDate, endDate, status])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  vendorId   String
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([vendorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model CommissionConfig {
  id            String       @id @default(cuid())
  city          String?
  carCategory   CarCategory?
  tripType      TripType?
  percentage    Decimal      @db.Decimal(5, 2)
  effectiveFrom DateTime
  createdAt     DateTime     @default(now())

  @@index([city])
}

model Payout {
  id        String       @id @default(cuid())
  vendorId  String
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(10, 2)
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([vendorId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpayRefundId  String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  refundAmount      Decimal?      @db.Decimal(10, 2)
  status            PaymentStatus @default(CREATED)
  refundStatus      RefundStatus  @default(NONE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([razorpayRefundId])
  @@index([razorpayOrderId])
}

model Banner {
  id           String   @id @default(cuid())
  imageUrl     String
  title        String
  ctaLink      String?
  displayOrder Int
  isActive     Boolean  @default(true)

  @@index([isActive])
}

model PlatformSettings {
  id               String   @id @default("singleton")
  platformName     String
  logoUrl          String?
  gstNumber        String
  supportEmail     String
  supportPhone     String
  appVersion       String
  enabledTripTypes String[] @default(["SELF_DRIVE", "OUTSTATION"])
}

model SupportedCity {
  id               String   @id @default(cuid())
  name             String   @unique
  state            String
  latitude         Float
  longitude        Float
  isActive         Boolean  @default(true)
  enabledTripTypes String[] @default([])
  createdAt        DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  description       String?
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Decimal       @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  minBookingAmount  Decimal?      @db.Decimal(10, 2)
  startDate         DateTime?
  expiresAt         DateTime?
  isActive          Boolean       @default(true)
  globalUsageLimit  Int?
  perCustomerLimit  Int?          @default(1)
  firstBookingOnly  Boolean       @default(false)
  city              String?
  tripType          TripType?
  carCategory       CarCategory?
  usageCount        Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookings          Booking[]
  usages            CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())

  @@index([couponId])
  @@index([customerId])
  @@index([bookingId])
}

model OtpRequest {
  id           String   @id @default(cuid())
  phone        String
  otpHash      String
  expiresAt    DateTime
  verified     Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([phone])
}

model SentBroadcast {
  id        String   @id @default(cuid())
  target    String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

model RecentlyViewed {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId    String
  car      Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@index([userId])
  @@index([carId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([targetType])
}

model Dispute {
  id             String            @id @default(cuid())
  bookingId      String            @unique
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedByUserId String
  raisedByUser   User              @relation(fields: [raisedByUserId], references: [id], onDelete: Cascade)
  reason         String
  status         DisputeStatus     @default(OPEN)
  resolutionNote String?
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?
  evidences      DisputeEvidence[]

  @@index([raisedByUserId])
  @@index([status])
}

model DisputeEvidence {
  id               String   @id @default(cuid())
  disputeId        String
  dispute          Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  fileUrl          String
  description      String?
  createdAt        DateTime @default(now())

  @@index([disputeId])
  @@index([uploadedByUserId])
}

model Inspection {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type           InspectionType
  performedById  String
  performedBy    User           @relation(fields: [performedById], references: [id], onDelete: Cascade)
  odometer       Decimal        @db.Decimal(10, 2)
  fuelPercent    Int
  conditionNotes String?
  damagePhotos   String[]
  finalized      Boolean        @default(false)
  finalizedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([bookingId, type])
  @@index([bookingId])
  @@index([performedById])
}

model HandoverOtp {
  id           String          @id @default(cuid())
  bookingId    String
  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  otpType      HandoverOtpType
  recipientId  String
  recipient    User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  otpHash      String
  expiresAt    DateTime
  verified     Boolean         @default(false)
  verifiedAt   DateTime?
  attemptCount Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([bookingId, otpType])
  @@index([recipientId])
}

model SecurityDeposit {
  id                String                @id @default(cuid())
  bookingId         String                @unique
  booking           Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount            Decimal               @db.Decimal(10, 2)
  refundedAmount    Decimal               @default(0) @db.Decimal(10, 2)
  deductedAmount    Decimal               @default(0) @db.Decimal(10, 2)
  razorpayPaymentId String?
  razorpayRefundId  String?               @unique
  status            SecurityDepositStatus @default(REQUIRED)
  heldAt            DateTime?
  releasedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([bookingId])
  @@index([status])
}

model DamageClaim {
  id              String            @id @default(cuid())
  bookingId       String
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  claimedAmount   Decimal           @db.Decimal(10, 2)
  approvedAmount  Decimal?          @db.Decimal(10, 2)
  status          DamageClaimStatus @default(SUBMITTED)
  description     String
  damagePhotos    String[]
  vendorNotes     String?
  adminNotes      String?
  customerDispute String?
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?

  @@index([bookingId])
  @@index([vendorId])
  @@index([status])
}

