datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPORT_AGENT
}

enum BusinessType {
  INDIVIDUAL
  CONSULTANCY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SubscriptionTier {
  BASIC
  PRO
}

enum DocumentType {
  RC_BOOK
  TRADE_LICENSE
  INSURANCE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CarCategory {
  HATCHBACK
  SEDAN
  SUV
  LUXURY
  TEMPO_TRAVELLER
  MINI_BUS
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
}

enum TripType {
  LOCAL
  OUTSTATION
  AIRPORT_TRANSFER
  SELF_DRIVE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DeliveryType {
  NONE
  DOORSTEP_DELIVERY
  DOORSTEP_PICKUP
  ROUND_TRIP_DELIVERY
}

enum ExtensionStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  HANDOVER_READY
  ONGOING
  RETURN_PENDING
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  NONE
  PENDING
  PROCESSED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
}

enum HandoverOtpType {
  PICKUP
  RETURN
}

enum SecurityDepositStatus {
  REQUIRED
  HELD
  REFUNDED
  PARTIALLY_REFUNDED
  FORFEITED
  CANCELLED
}

enum DamageClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TicketCategory {
  BOOKING
  PAYMENT
  REFUND
  SECURITY_DEPOSIT
  VEHICLE
  PICKUP_DELIVERY
  KYC_LICENCE
  TRIP_EXTENSION
  DAMAGE_DISPUTE
  EMERGENCY
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_VENDOR
  RESOLVED
  CLOSED
}

enum IncidentType {
  ACCIDENT
  BREAKDOWN
  FLAT_TYRE
  BATTERY
  LOCKOUT
  FUEL_EMERGENCY
  ENGINE_ISSUE
  TOWING_REQUIRED
  MEDICAL_EMERGENCY
  OTHER
}

enum EmergencyStatus {
  REQUESTED
  ACKNOWLEDGED
  ASSIGNED
  PROVIDER_EN_ROUTE
  CUSTOMER_CONTACTED
  ON_SITE
  RESOLVED
  CANCELLED
}

enum ProtectionPlanCode {
  BASIC
  STANDARD
  PREMIUM
  ZERO_DEP
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletBucketType {
  REAL_MONEY
  PROMOTIONAL
  REFUND_CREDIT
}

enum LedgerEntryType {
  CUSTOMER_DEPOSIT
  CHECKOUT_DEBIT
  BOOKING_REFUND
  REFERRAL_REWARD
  LOYALTY_CONVERSION
  ADMIN_ADJUSTMENT
  CANCELLATION_CREDIT
  EXPIRATION
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum ReferralStatus {
  INVITED
  REGISTERED
  QUALIFIED
  REWARDED
  CANCELLED
  EXPIRED
  FRAUD_BLOCKED
}

enum LoyaltyTierCode {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  TRIP_COMPLETION_EARNED
  PROMOTION_BONUS
  REDEMPTION_TO_WALLET
  TIER_UPGRADE_BONUS
  ADMIN_ADJUSTMENT
  CANCELLATION_REVERSAL
  POINTS_EXPIRY
}

model User {
  id               String            @id @default(cuid())
  name             String
  phone            String            @unique
  email            String?
  role             Role
  passwordHash     String?
  profilePhotoUrl  String?
  banned           Boolean           @default(false)
  referralCode     String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fcmToken         String?
  vendor           Vendor?
  bookings         Booking[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  wishlists        Wishlist[]
  recentlyViewed   RecentlyViewed[]
  auditLogs        AuditLog[]
  disputesRaised   Dispute[]
  disputeEvidences DisputeEvidence[]
  inspections      Inspection[]
  handoverOtpsReceived HandoverOtp[]
  couponUsages     CouponUsage[]
  customerKyc      CustomerKyc?
  invoices         Invoice[]
  supportTicketsCreated SupportTicket[] @relation("CustomerTickets")
  supportTicketsAssigned SupportTicket[] @relation("AssignedTickets")
  ticketMessages   TicketMessage[]
  emergencyRequests EmergencyRequest[]
  wallet           Wallet?
  referralsSent    ReferralAttribution[] @relation("ReferrerAttributions")
  referralReceived ReferralAttribution?  @relation("RefereeAttribution")
  loyaltyAccount   LoyaltyAccount?

  @@index([phone])
  @@index([role])
}

model Vendor {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  ownerName          String
  city               String
  locality           String?
  latitude           Float?
  longitude          Float?
  gstNumber          String?
  panNumber          String?
  bankDetails        String? // Plain text or JSON
  businessType       BusinessType
  yearsInOperation   Int?
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(0)
  isSponsored        Boolean            @default(false)
  boostExpiresAt     DateTime?
  branchOfId         String?
  branchOf           Vendor?            @relation("VendorBranches", fields: [branchOfId], references: [id], onDelete: SetNull)
  branches           Vendor[]           @relation("VendorBranches")
  subscriptionTier   SubscriptionTier   @default(BASIC)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          Document[]
  cars               Car[]
  bookings           Booking[]
  payouts            Payout[]
  damageClaims       DamageClaim[]
  invoices           Invoice[]
  emergencyRequests  EmergencyRequest[]

  @@index([city])
  @@index([verificationStatus])
  @@index([branchOfId])
  @@index([city, verificationStatus])
  @@index([isSponsored, boostExpiresAt])
  @@index([rating])
}

model Document {
  id         String         @id @default(cuid())
  vendorId   String
  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  carId      String?
  car        Car?           @relation(fields: [carId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  uploadedAt DateTime       @default(now())

  @@index([vendorId])
  @@index([carId])
  @@index([type])
}

model Car {
  id                     String           @id @default(cuid())
  vendorId               String
  vendor                 Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  make                   String
  model                  String
  year                   Int
  type                   CarCategory
  fuelType               FuelType
  seating                Int
  isAC                   Boolean
  registrationNumber     String
  photos                 String[]
  pricePerKm             Decimal          @db.Decimal(10, 2)
  pricePerDay            Decimal          @db.Decimal(10, 2)
  pricePerHour           Decimal          @db.Decimal(10, 2)
  weeklyDiscountPercent  Float?           @default(0)
  monthlyDiscountPercent Float?           @default(0)
  isAvailable            Boolean          @default(true)
  availableTripTypes     String[] // String[] representation of TripType enum values
  blockedDates           DateTime[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  documents              Document[]
  bookings               Booking[]
  wishlists              Wishlist[]
  recentlyViewed         RecentlyViewed[]
  emergencyRequests      EmergencyRequest[]
  mileagePackages        MileagePackage[]

  @@index([vendorId])
  @@index([type])
  @@index([isAvailable])
  @@index([vendorId, isAvailable])
  @@index([type, pricePerDay])
}

model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  carId              String
  car                Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  tripType           TripType
  pickupLocation     String
  dropLocation       String?
  startDate          DateTime
  endDate            DateTime
  distanceKm         Decimal?      @db.Decimal(10, 2)
  baseFare           Decimal       @db.Decimal(10, 2)
  platformFee        Decimal       @db.Decimal(10, 2)
  gstAmount          Decimal       @db.Decimal(10, 2)
  totalFare          Decimal       @db.Decimal(10, 2)
  netToVendor        Decimal       @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  cancellationFee    Decimal?      @db.Decimal(10, 2)
  refundAmount       Decimal?      @db.Decimal(10, 2)
  cancelledAt        DateTime?
  cancelledBy        String?
  disputeFlag        Boolean       @default(false)
  disputeNote        String?
  driverIncluded     Boolean       @default(true)
  childSeat          Boolean       @default(false)
  extraLuggage       Boolean       @default(false)
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  discountAmount     Decimal?          @db.Decimal(10, 2)
  deliveryType       DeliveryType      @default(NONE)
  deliveryAddress    String?
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  deliveryFee        Decimal           @default(0) @db.Decimal(10, 2)
  pickupAddress      String?
  pickupLatitude     Float?
  pickupLongitude    Float?
  pickupFee          Decimal           @default(0) @db.Decimal(10, 2)
  protectionPackageId String?
  protectionPackage  ProtectionPackage? @relation(fields: [protectionPackageId], references: [id], onDelete: SetNull)
  protectionCode     String?
  protectionFee      Decimal           @default(0) @db.Decimal(10, 2)
  protectionDeductible Decimal?        @db.Decimal(10, 2)
  walletDeduction    Decimal           @default(0) @db.Decimal(10, 2)
  // Mileage Package Pricing Snapshot
  mileagePackageId       String?
  mileagePackage         MileagePackage?   @relation(fields: [mileagePackageId], references: [id], onDelete: SetNull)
  mileagePackageName     String?
  includedKmPerDay       Int?
  includedKmTotal        Int?
  packageBasePricePerDay Decimal?          @db.Decimal(10, 2)
  extraKmRate            Decimal?          @db.Decimal(10, 2)
  pricingBasis           String            @default("LEGACY_DAILY")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  review             Review?
  payment            Payment?
  dispute            Dispute?
  inspections        Inspection[]
  handoverOtps       HandoverOtp[]
  securityDeposit    SecurityDeposit?
  damageClaims       DamageClaim[]
  couponUsage        CouponUsage?
  invoice            Invoice?
  creditNotes        CreditNote[]
  extensions         TripExtension[]
  additionalDrivers  AdditionalDriver[]
  supportTickets     SupportTicket[]
  emergencyRequests  EmergencyRequest[]

  @@index([customerId])
  @@index([vendorId])
  @@index([carId])
  @@index([status])
  @@index([createdAt])
  @@index([mileagePackageId])
  @@index([carId, startDate, endDate, status])
  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([status, createdAt])
}

model MileagePackage {
  id               String    @id @default(cuid())
  carId            String
  car              Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  tripType         TripType
  name             String
  includedKmPerDay Int?      // null = Unlimited
  basePricePerDay  Decimal   @db.Decimal(10, 2)
  extraKmRate      Decimal   @default(0) @db.Decimal(10, 2)
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]

  @@index([carId])
  @@index([tripType])
  @@index([isActive])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  vendorId   String
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([vendorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead, createdAt])
}

model CommissionConfig {
  id            String       @id @default(cuid())
  city          String?
  carCategory   CarCategory?
  tripType      TripType?
  percentage    Decimal      @db.Decimal(5, 2)
  effectiveFrom DateTime
  createdAt     DateTime     @default(now())

  @@index([city])
}

model Payout {
  id        String       @id @default(cuid())
  vendorId  String
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(10, 2)
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([vendorId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpayRefundId  String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  refundAmount      Decimal?      @db.Decimal(10, 2)
  status            PaymentStatus @default(CREATED)
  refundStatus      RefundStatus  @default(NONE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([razorpayRefundId])
  @@index([razorpayOrderId])
  @@index([status, createdAt])
  @@index([bookingId, status])
}

model Banner {
  id           String   @id @default(cuid())
  imageUrl     String
  title        String
  ctaLink      String?
  displayOrder Int
  isActive     Boolean  @default(true)

  @@index([isActive])
}

model PlatformSettings {
  id               String   @id @default("singleton")
  platformName     String
  logoUrl          String?
  gstNumber        String
  supportEmail     String
  supportPhone     String
  appVersion       String
  enabledTripTypes String[] @default(["SELF_DRIVE", "OUTSTATION"])
}

model SupportedCity {
  id               String   @id @default(cuid())
  name             String   @unique
  state            String
  latitude         Float
  longitude        Float
  isActive         Boolean  @default(true)
  enabledTripTypes String[] @default([])
  createdAt        DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  description       String?
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Decimal       @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  minBookingAmount  Decimal?      @db.Decimal(10, 2)
  startDate         DateTime?
  expiresAt         DateTime?
  isActive          Boolean       @default(true)
  globalUsageLimit  Int?
  perCustomerLimit  Int?          @default(1)
  firstBookingOnly  Boolean       @default(false)
  city              String?
  tripType          TripType?
  carCategory       CarCategory?
  usageCount        Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookings          Booking[]
  usages            CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())

  @@index([couponId])
  @@index([customerId])
  @@index([bookingId])
}

model OtpRequest {
  id           String   @id @default(cuid())
  phone        String
  otpHash      String
  expiresAt    DateTime
  verified     Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([phone])
}

model SentBroadcast {
  id        String   @id @default(cuid())
  target    String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

model RecentlyViewed {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId    String
  car      Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@index([userId])
  @@index([carId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([targetType])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Dispute {
  id             String            @id @default(cuid())
  bookingId      String            @unique
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedByUserId String
  raisedByUser   User              @relation(fields: [raisedByUserId], references: [id], onDelete: Cascade)
  reason         String
  status         DisputeStatus     @default(OPEN)
  resolutionNote String?
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?
  evidences      DisputeEvidence[]

  @@index([raisedByUserId])
  @@index([status])
}

model DisputeEvidence {
  id               String   @id @default(cuid())
  disputeId        String
  dispute          Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  fileUrl          String
  description      String?
  createdAt        DateTime @default(now())

  @@index([disputeId])
  @@index([uploadedByUserId])
}

model Inspection {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type           InspectionType
  performedById  String
  performedBy    User           @relation(fields: [performedById], references: [id], onDelete: Cascade)
  odometer       Decimal        @db.Decimal(10, 2)
  fuelPercent    Int
  conditionNotes String?
  damagePhotos   String[]
  finalized      Boolean        @default(false)
  finalizedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([bookingId, type])
  @@index([bookingId])
  @@index([performedById])
}

model HandoverOtp {
  id           String          @id @default(cuid())
  bookingId    String
  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  otpType      HandoverOtpType
  recipientId  String
  recipient    User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  otpHash      String
  expiresAt    DateTime
  verified     Boolean         @default(false)
  verifiedAt   DateTime?
  attemptCount Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([bookingId, otpType])
  @@index([recipientId])
}

model SecurityDeposit {
  id                String                @id @default(cuid())
  bookingId         String                @unique
  booking           Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount            Decimal               @db.Decimal(10, 2)
  refundedAmount    Decimal               @default(0) @db.Decimal(10, 2)
  deductedAmount    Decimal               @default(0) @db.Decimal(10, 2)
  razorpayPaymentId String?
  razorpayRefundId  String?               @unique
  status            SecurityDepositStatus @default(REQUIRED)
  heldAt            DateTime?
  releasedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([bookingId])
  @@index([status])
}

model DamageClaim {
  id              String            @id @default(cuid())
  bookingId       String
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  claimedAmount   Decimal           @db.Decimal(10, 2)
  approvedAmount  Decimal?          @db.Decimal(10, 2)
  status          DamageClaimStatus @default(SUBMITTED)
  description     String
  damagePhotos    String[]
  vendorNotes     String?
  adminNotes      String?
  customerDispute String?
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?

  @@index([bookingId])
  @@index([vendorId])
  @@index([status])
}

model CustomerKyc {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenceNumber   String
  expiryDate      DateTime
  licenceFrontUrl String
  licenceBackUrl  String
  status          KycStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model DepositRule {
  id            String      @id @default(cuid())
  carCategory   CarCategory
  city          String?
  depositAmount Decimal     @db.Decimal(10, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([carCategory, city])
  @@index([carCategory])
  @@index([city])
}

model Invoice {
  id             String       @id @default(cuid())
  invoiceNumber  String       @unique
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId      String
  customerId     String
  customer       User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  baseFare       Decimal      @db.Decimal(10, 2)
  platformFee    Decimal      @db.Decimal(10, 2)
  protectionFee  Decimal      @default(0) @db.Decimal(10, 2)
  gstRate        Decimal      @default(18.00) @db.Decimal(5, 2)
  gstAmount      Decimal      @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  totalFare      Decimal      @db.Decimal(10, 2)
  depositAmount  Decimal      @default(0) @db.Decimal(10, 2)
  pdfUrl         String?
  issuedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  creditNotes    CreditNote[]

  @@index([customerId])
  @@index([vendorId])
  @@index([issuedAt])
}

model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String   @unique
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingId        String
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount           Decimal  @db.Decimal(10, 2)
  reason           String
  issuedAt         DateTime @default(now())
  pdfUrl           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([invoiceId])
  @@index([bookingId])
}

model TripExtension {
  id                String          @id @default(cuid())
  bookingId         String
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  currentEndDate    DateTime
  requestedEndDate  DateTime
  extraDays         Int             @default(0)
  extraHours        Int             @default(0)
  baseFare          Decimal         @db.Decimal(10, 2)
  platformFee       Decimal         @db.Decimal(10, 2)
  gstAmount         Decimal         @db.Decimal(10, 2)
  totalFare         Decimal         @db.Decimal(10, 2)
  netToVendor       Decimal         @db.Decimal(10, 2)
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            ExtensionStatus @default(PENDING_PAYMENT)
  invoiceNumber     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
}

model AdditionalDriver {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName        String
  phone           String
  email           String?
  licenceNumber   String
  licenceFrontUrl String
  licenceBackUrl  String
  expiryDate      DateTime
  kycStatus       KycStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  feeAmount       Decimal   @default(0) @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId])
  @@index([licenceNumber])
  @@index([kycStatus])
}

model SupportTicket {
  id               String          @id @default(cuid())
  ticketNumber     String          @unique
  customerId       String
  customer         User            @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  bookingId        String?
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category         TicketCategory
  priority         TicketPriority  @default(NORMAL)
  subject          String
  description      String
  status           TicketStatus    @default(OPEN)
  assignedToUserId String?
  assignedToUser   User?           @relation("AssignedTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  messages         TicketMessage[]

  @@index([customerId])
  @@index([bookingId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([assignedToUserId])
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole  Role
  message     String
  attachments String[]
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@index([senderId])
}

model EmergencyRequest {
  id                   String          @id @default(cuid())
  requestNumber        String          @unique
  customerId           String
  customer             User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId            String
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  carId                String
  car                  Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
  vendorId             String
  vendor               Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  city                 String
  incidentType         IncidentType
  urgency              TicketPriority  @default(URGENT)
  status               EmergencyStatus @default(REQUESTED)
  customerNotes        String?
  latitude             Float?
  longitude            Float?
  locationAddress      String?
  assignedProviderName String?
  assignedProviderPhone String?
  contactNotes         String?
  resolutionNotes      String?
  estimatedEtaMinutes  Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  resolvedAt           DateTime?

  @@index([customerId])
  @@index([bookingId])
  @@index([vendorId])
  @@index([city])
  @@index([status])
  @@index([incidentType])
}

model ProtectionPackage {
  id                String             @id @default(cuid())
  name              String
  code              ProtectionPlanCode
  description       String
  dailyRate         Decimal            @db.Decimal(10, 2)
  coverageSummary   String[]
  deductibleAmount  Decimal            @db.Decimal(10, 2)
  maxCoverageAmount Decimal            @db.Decimal(10, 2)
  exclusions        String[]
  termsUrl          String?
  city              String?
  isActive          Boolean            @default(true)
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bookings          Booking[]

  @@unique([code, city])
  @@index([city])
  @@index([isActive])
}

model Wallet {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         String               @default("INR")
  availableBalance Decimal              @default(0) @db.Decimal(10, 2)
  lockedBalance    Decimal              @default(0) @db.Decimal(10, 2)
  realBalance      Decimal              @default(0) @db.Decimal(10, 2)
  promoBalance     Decimal              @default(0) @db.Decimal(10, 2)
  status           WalletStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ledgerEntries    WalletLedgerEntry[]

  @@index([userId])
  @@index([status])
}

model WalletLedgerEntry {
  id             String           @id @default(cuid())
  walletId       String
  wallet         Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           LedgerEntryType
  direction      LedgerDirection
  bucket         WalletBucketType
  amount         Decimal          @db.Decimal(10, 2)
  balanceBefore  Decimal          @db.Decimal(10, 2)
  balanceAfter   Decimal          @db.Decimal(10, 2)
  referenceType  String           // "BOOKING", "PAYMENT", "REFERRAL", "LOYALTY", "ADMIN", etc.
  referenceId    String?          // Entity CUID
  idempotencyKey String           @unique
  description    String
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([walletId])
  @@index([referenceType, referenceId])
  @@index([bucket])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([walletId, bucket])
}

model ReferralCampaign {
  id                    String        @id @default(cuid())
  name                  String
  code                  String        @unique
  referrerRewardAmount  Decimal       @db.Decimal(10, 2)
  refereeRewardAmount   Decimal       @db.Decimal(10, 2)
  minBookingAmount      Decimal       @default(1000) @db.Decimal(10, 2)
  city                  String?
  startDate             DateTime?
  endDate               DateTime?
  isActive              Boolean       @default(true)
  maxReferralsPerUser   Int           @default(20)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  attributions          ReferralAttribution[]

  @@index([code])
  @@index([city])
  @@index([isActive])
}

model ReferralAttribution {
  id                     String            @id @default(cuid())
  referrerId             String
  referrer               User              @relation("ReferrerAttributions", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId              String            @unique
  referee                User              @relation("RefereeAttribution", fields: [refereeId], references: [id], onDelete: Cascade)
  campaignId             String?
  campaign               ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  referralCodeUsed       String
  status                 ReferralStatus    @default(REGISTERED)
  qualifyingBookingId    String?
  referrerRewardAmount   Decimal           @default(0) @db.Decimal(10, 2)
  refereeRewardAmount    Decimal           @default(0) @db.Decimal(10, 2)
  referrerLedgerEntryId  String?
  refereeLedgerEntryId   String?
  fraudFlags             String[]          @default([])
  createdAt              DateTime          @default(now())
  qualifiedAt            DateTime?
  rewardedAt             DateTime?

  @@index([referrerId])
  @@index([refereeId])
  @@index([referralCodeUsed])
  @@index([status])
  @@index([referrerId, status])
}

model LoyaltyTier {
  id                    String          @id @default(cuid())
  code                  LoyaltyTierCode @unique
  name                  String
  minPointsRequired     Int             @default(0)
  pointsMultiplier      Decimal         @default(1.00) @db.Decimal(3, 2)
  cashbackPercent       Decimal         @default(1.00) @db.Decimal(5, 2)
  prioritySupport       Boolean         @default(false)
  freeCancellationCount Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  accounts              LoyaltyAccount[]
}

model LoyaltyAccount {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId           String
  tier             LoyaltyTier          @relation(fields: [tierId], references: [id])
  pointsBalance    Int                  @default(0)
  lifetimePoints   Int                  @default(0)
  tierExpiresAt    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactions     LoyaltyTransaction[]

  @@index([userId])
  @@index([tierId])
}

model LoyaltyTransaction {
  id             String                 @id @default(cuid())
  accountId      String
  account        LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           LoyaltyTransactionType
  points         Int
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String
  referenceId    String?
  idempotencyKey String                 @unique
  description    String
  createdAt      DateTime               @default(now())

  @@index([accountId])
  @@index([createdAt])
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppMessageType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  REFUND_PROCESSED
  HANDOVER_READY
  TRIP_REMINDER
  EMERGENCY_ALERT
  MARKETING_PROMO
}

model WhatsAppMessage {
  id                String                @id @default(cuid())
  userId            String?
  bookingId         String?
  phoneNumber       String
  templateName      String
  templateLanguage  String                @default("en_US")
  messageType       WhatsAppMessageType
  status            WhatsAppMessageStatus @default(QUEUED)
  providerMessageId String?               @unique
  idempotencyKey    String                @unique
  variables         Json?
  failureCode       String?
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([phoneNumber])
  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([messageType])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   @default("GENERAL")
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}
