datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPORT_AGENT
}

enum BusinessType {
  INDIVIDUAL
  CONSULTANCY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SubscriptionTier {
  BASIC
  PRO
}

enum DocumentType {
  RC_BOOK
  TRADE_LICENSE
  INSURANCE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RequirementCategory {
  DOCUMENT
  MONETARY
  PHYSICAL_ASSET
  VERIFICATION
  OTHER
}

enum RequirementScope {
  GLOBAL
  VENDOR_SPECIFIC
  VEHICLE_CATEGORY
  SERVICE_AREA
}

enum RequirementFulfillmentStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  WAIVED
}

enum VendorDepositStatus {
  REQUIRED
  PENDING
  PARTIALLY_PAID
  PAID
  HELD
  RELEASED
  REFUNDED
  FORFEITED
}

enum VendorDepositTransactionType {
  INITIAL_PAYMENT
  PARTIAL_PAYMENT
  TOP_UP
  RELEASE
  REFUND
  FORFEITURE
  ADMIN_ADJUSTMENT
}

enum VehicleOperationalStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
  RETIRED
}

enum VehicleVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CarCategory {
  HATCHBACK
  SEDAN
  SUV
  LUXURY
  TEMPO_TRAVELLER
  MINI_BUS
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
}

enum TripType {
  LOCAL
  OUTSTATION
  AIRPORT_TRANSFER
  SELF_DRIVE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DeliveryType {
  NONE
  DOORSTEP_DELIVERY
  DOORSTEP_PICKUP
  ROUND_TRIP_DELIVERY
}

enum VendorLocationType {
  VENDOR_YARD
  BRANCH
  AIRPORT
  RAILWAY_STATION
  BUS_TERMINAL
  PUBLIC_POINT
  COMMERCIAL_OFFICE
}

enum LocationStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SUSPENDED
  ARCHIVED
  INACTIVE
}

enum ServiceAreaStatus {
  ACTIVE
  COMING_SOON
  INACTIVE
}

enum DeliveryPricingModel {
  FREE
  FIXED
  DISTANCE_BASED
}

enum LocationExceptionType {
  HOLIDAY
  TEMPORARY_CLOSURE
  EMERGENCY_CLOSURE
  CUSTOM_HOURS
}

enum ExtensionStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  HANDOVER_READY
  ONGOING
  RETURN_PENDING
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
  REVERSED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  NONE
  REQUESTED
  PENDING
  PROCESSED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
}

enum PricingRuleScope {
  PLATFORM
  VENDOR
  BRANCH
  VEHICLE_CLASS
}

enum HandoverOtpType {
  PICKUP
  RETURN
}

enum VehicleBlockType {
  MAINTENANCE
  ACCIDENT_REPAIR
  ROUTINE_INSPECTION
  VENDOR_BLACKOUT
  ADMIN_LOCK
  SAFETY_HOLD
}

enum VehicleHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED
}

enum SecurityDepositStatus {
  REQUIRED
  HELD
  REFUNDED
  PARTIALLY_REFUNDED
  FORFEITED
  CANCELLED
}

enum DamageClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TicketCategory {
  BOOKING
  PAYMENT
  REFUND
  SECURITY_DEPOSIT
  VEHICLE
  PICKUP_DELIVERY
  KYC_LICENCE
  TRIP_EXTENSION
  DAMAGE_DISPUTE
  EMERGENCY
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_VENDOR
  RESOLVED
  CLOSED
}

enum IncidentType {
  ACCIDENT
  BREAKDOWN
  FLAT_TYRE
  BATTERY
  LOCKOUT
  FUEL_EMERGENCY
  ENGINE_ISSUE
  TOWING_REQUIRED
  MEDICAL_EMERGENCY
  OTHER
}

enum EmergencyStatus {
  REQUESTED
  ACKNOWLEDGED
  ASSIGNED
  PROVIDER_EN_ROUTE
  CUSTOMER_CONTACTED
  ON_SITE
  RESOLVED
  CANCELLED
}

enum ProtectionPlanCode {
  BASIC
  STANDARD
  PREMIUM
  ZERO_DEP
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletBucketType {
  REAL_MONEY
  PROMOTIONAL
  REFUND_CREDIT
}

enum LedgerEntryType {
  CUSTOMER_DEPOSIT
  CHECKOUT_DEBIT
  BOOKING_REFUND
  REFERRAL_REWARD
  LOYALTY_CONVERSION
  ADMIN_ADJUSTMENT
  CANCELLATION_CREDIT
  EXPIRATION
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum ReferralStatus {
  INVITED
  REGISTERED
  QUALIFIED
  REWARDED
  CANCELLED
  EXPIRED
  FRAUD_BLOCKED
}

enum LoyaltyTierCode {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  TRIP_COMPLETION_EARNED
  PROMOTION_BONUS
  REDEMPTION_TO_WALLET
  TIER_UPGRADE_BONUS
  ADMIN_ADJUSTMENT
  CANCELLATION_REVERSAL
  POINTS_EXPIRY
}

model User {
  id               String            @id @default(cuid())
  name             String
  phone            String            @unique
  email            String?
  role             Role
  passwordHash     String?
  profilePhotoUrl  String?
  banned           Boolean           @default(false)
  referralCode     String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fcmToken         String?
  vendor           Vendor?
  bookings         Booking[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  wishlists        Wishlist[]
  recentlyViewed   RecentlyViewed[]
  auditLogs        AuditLog[]
  disputesRaised   Dispute[]
  disputeEvidences DisputeEvidence[]
  inspections      Inspection[]
  handoverOtpsReceived HandoverOtp[]
  couponUsages     CouponUsage[]
  customerKyc      CustomerKyc?
  invoices         Invoice[]
  supportTicketsCreated SupportTicket[] @relation("CustomerTickets")
  supportTicketsAssigned SupportTicket[] @relation("AssignedTickets")
  ticketMessages   TicketMessage[]
  emergencyRequests EmergencyRequest[]
  wallet           Wallet?
  referralsSent    ReferralAttribution[] @relation("ReferrerAttributions")
  referralReceived ReferralAttribution?  @relation("RefereeAttribution")
  loyaltyAccount   LoyaltyAccount?
  devices          UserDevice[]
  notificationPreference NotificationPreference?
  financialAdjustmentsApproved FinancialAdjustment[]
  checkoutSessions CheckoutSession[]

  @@index([phone])
  @@index([role])
}

model Vendor {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  ownerName          String
  city               String
  locality           String?
  latitude           Float?
  longitude          Float?
  gstNumber          String?
  panNumber          String?
  bankDetails        String? // Plain text or JSON
  businessType       BusinessType
  yearsInOperation   Int?
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(0)
  isSponsored        Boolean            @default(false)
  boostExpiresAt     DateTime?
  branchOfId         String?
  branchOf           Vendor?            @relation("VendorBranches", fields: [branchOfId], references: [id], onDelete: SetNull)
  branches           Vendor[]           @relation("VendorBranches")
  subscriptionTier   SubscriptionTier   @default(BASIC)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          Document[]
  cars               Car[]
  bookings           Booking[]
  payouts            Payout[]
  damageClaims       DamageClaim[]
  invoices           Invoice[]
  emergencyRequests  EmergencyRequest[]
  pickupHubs         PickupHub[]
  deliveryPolicy     VendorDeliveryPolicy?
  locationMatrices   VendorLocationMatrix[]
  sponsoredCampaigns SponsoredCampaign[]
  serviceAreaAssignments VendorServiceArea[]
  onboardingRequirements VendorRequirementState[]
  vendorSecurityDeposit  VendorSecurityDeposit?
  rentalPricingRules     RentalPricingRule[]
  ancillaryProducts      AncillaryProduct[]
  scopedCoupons          Coupon[]
  cancellationPolicies   CancellationPolicyDefinition[]
  fulfillmentRecords     FulfillmentRecord[]
  dynamicPricingPolicies DynamicPricingPolicy[]
  commissionRules        MarketplaceCommissionRule[]
  corporateAccounts      CorporateAccount[]

  @@index([city])
  @@index([verificationStatus])
  @@index([branchOfId])
  @@index([city, verificationStatus])
  @@index([isSponsored, boostExpiresAt])
  @@index([rating])
}

model PickupHub {
  id              String             @id @default(cuid())
  vendorId        String
  vendor          Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  address         String
  locality        String?
  city            String
  state           String?
  latitude        Float
  longitude       Float
  serviceRadiusKm Float              @default(25.0)
  operatingHours  String?
  contactPhone    String?
  isActive        Boolean            @default(true)
  locationType    VendorLocationType @default(VENDOR_YARD)
  status          LocationStatus     @default(ACTIVE)
  allowsPickup    Boolean            @default(true)
  allowsReturn    Boolean            @default(true)
  allowsDelivery  Boolean            @default(true)
  pickupFee       Decimal            @default(0) @db.Decimal(10, 2)
  returnFee       Decimal            @default(0) @db.Decimal(10, 2)
  oneWayFee       Decimal            @default(0) @db.Decimal(10, 2)
  is24x7          Boolean            @default(false)
  openingTime     String?            @default("08:00")
  closingTime     String?            @default("22:00")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cars            Car[]
  exceptions      LocationException[]
  rentalPricingRules RentalPricingRule[]
  ancillaryProducts    AncillaryProduct[]
  scopedCoupons        Coupon[]
  cancellationPolicies CancellationPolicyDefinition[]
  fulfillmentRecords   FulfillmentRecord[]
  dynamicPricingPolicies DynamicPricingPolicy[]
  transferRecommendationsSource InventoryTransferRecommendation[] @relation("SourceBranchTransfers")
  transferRecommendationsDest InventoryTransferRecommendation[] @relation("DestBranchTransfers")
  commissionRules      MarketplaceCommissionRule[]

  @@index([vendorId])
  @@index([city])
  @@index([city, isActive])
  @@index([isActive])
  @@index([locationType])
  @@index([status])
}

model LocationException {
  id                String                @id @default(cuid())
  locationId        String
  location          PickupHub             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date              DateTime
  exceptionType     LocationExceptionType @default(HOLIDAY)
  isClosed          Boolean               @default(true)
  customOpeningTime String?
  customClosingTime String?
  reason            String?
  createdAt         DateTime              @default(now())

  @@index([locationId])
  @@index([date])
}

model VendorDeliveryPolicy {
  id                   String               @id @default(cuid())
  vendorId             String               @unique
  vendor               Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deliveryEnabled      Boolean              @default(true)
  maxDeliveryRadiusKm  Float                @default(25.0)
  pricingModel         DeliveryPricingModel @default(DISTANCE_BASED)
  baseDeliveryFee      Decimal              @default(100.0) @db.Decimal(10, 2)
  perKmDeliveryFee     Decimal              @default(20.0) @db.Decimal(10, 2)
  freeDeliveryWithinKm Float                @default(5.0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([vendorId])
}

model VendorLocationMatrix {
  id               String   @id @default(cuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pickupLocationId String
  returnLocationId String
  isSupported      Boolean  @default(true)
  oneWaySurcharge  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([vendorId, pickupLocationId, returnLocationId])
  @@index([vendorId])
  @@index([pickupLocationId])
  @@index([returnLocationId])
}

model PublicTransportPoint {
  id         String             @id @default(cuid())
  name       String
  type       VendorLocationType @default(AIRPORT)
  city       String
  state      String?
  locality   String?
  latitude   Float
  longitude  Float
  category   String
  isApproved Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([city])
  @@index([type])
  @@index([city, isApproved])
}

model Document {
  id         String         @id @default(cuid())
  vendorId   String
  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  carId      String?
  car        Car?           @relation(fields: [carId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  uploadedAt DateTime       @default(now())
  vendorRequirementStates VendorRequirementState[]

  @@index([vendorId])
  @@index([carId])
  @@index([type])
}

model Car {
  id                     String           @id @default(cuid())
  vendorId               String
  vendor                 Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pickupHubId            String?
  pickupHub              PickupHub?       @relation(fields: [pickupHubId], references: [id], onDelete: SetNull)
  make                   String
  model                  String
  year                   Int
  type                   CarCategory
  fuelType               FuelType
  seating                Int
  isAC                   Boolean
  registrationNumber     String
  photos                 String[]
  pricePerKm             Decimal          @db.Decimal(10, 2)
  pricePerDay            Decimal          @db.Decimal(10, 2)
  pricePerHour           Decimal          @db.Decimal(10, 2)
  weeklyDiscountPercent  Float?           @default(0)
  monthlyDiscountPercent Float?           @default(0)
  isAvailable            Boolean                   @default(true)
  operationalStatus      VehicleOperationalStatus  @default(DRAFT)
  verificationStatus     VehicleVerificationStatus @default(PENDING)
  serviceAreaId          String?
  serviceArea            ServiceArea?              @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  rejectionReason        String?
  verifiedAt             DateTime?
  reviewedByUserId       String?
  maintenanceReason      String?
  maintenanceStartedAt   DateTime?
  expectedReturnDate     DateTime?
  availableTripTypes     String[] // String[] representation of TripType enum values
  blockedDates           DateTime[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  documents              Document[]
  bookings               Booking[]
  wishlists              Wishlist[]
  recentlyViewed         RecentlyViewed[]
  emergencyRequests      EmergencyRequest[]
  mileagePackages        MileagePackage[]
  sponsoredCampaigns     SponsoredCampaign[]
  featuredListings       FeaturedListing[]
  blocks                 VehicleBlock[]
  holds                  VehicleHold[]
  quotes                 BookingQuote[]
  auditLogs              VehicleAuditLog[]
  allocationRecords      VehicleAllocationRecord[]
  rentalPricingRules     RentalPricingRule[]
  fulfillmentRecords     FulfillmentRecord[]
  substitutionsAsOriginal VehicleSubstitutionRecord[] @relation("OriginalCarSubstitutions")
  substitutionsAsReplacement VehicleSubstitutionRecord[] @relation("ReplacementCarSubstitutions")

  @@index([vendorId])
  @@index([pickupHubId])
  @@index([type])
  @@index([isAvailable])
  @@index([operationalStatus])
  @@index([verificationStatus])
  @@index([serviceAreaId])
  @@index([vendorId, isAvailable])
  @@index([vendorId, operationalStatus])
  @@index([type, pricePerDay])
}

model VehicleAuditLog {
  id         String                    @id @default(cuid())
  carId      String
  car        Car                       @relation(fields: [carId], references: [id], onDelete: Cascade)
  actorId    String
  actorRole  Role                      @default(VENDOR)
  action     String
  fromStatus VehicleOperationalStatus?
  toStatus   VehicleOperationalStatus
  reason     String?
  metadata   Json?
  createdAt  DateTime                  @default(now())

  @@index([carId])
  @@index([action])
  @@index([createdAt])
}

model VehicleBlock {
  id          String           @id @default(cuid())
  carId       String
  car         Car              @relation(fields: [carId], references: [id], onDelete: Cascade)
  vendorId    String
  startDate   DateTime
  endDate     DateTime
  blockType   VehicleBlockType @default(VENDOR_BLACKOUT)
  reason      String?
  actorId     String
  actorRole   Role             @default(VENDOR)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([carId])
  @@index([vendorId])
  @@index([carId, startDate, endDate])
  @@index([startDate, endDate])
}

model VehicleHold {
  id             String            @id @default(cuid())
  carId          String
  car            Car               @relation(fields: [carId], references: [id], onDelete: Cascade)
  customerId     String
  vendorId       String
  startDate      DateTime
  endDate        DateTime
  expiresAt      DateTime
  status         VehicleHoldStatus @default(ACTIVE)
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([carId])
  @@index([customerId])
  @@index([vendorId])
  @@index([carId, startDate, endDate, status])
  @@index([status, expiresAt])
}

model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  carId              String
  car                Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  tripType           TripType
  pickupLocation     String
  dropLocation       String?
  startDate          DateTime
  endDate            DateTime
  distanceKm         Decimal?      @db.Decimal(10, 2)
  baseFare           Decimal       @db.Decimal(10, 2)
  platformFee        Decimal       @db.Decimal(10, 2)
  gstAmount          Decimal       @db.Decimal(10, 2)
  totalFare          Decimal       @db.Decimal(10, 2)
  netToVendor        Decimal       @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  cancellationFee    Decimal?      @db.Decimal(10, 2)
  refundAmount       Decimal?      @db.Decimal(10, 2)
  cancelledAt        DateTime?
  cancelledBy        String?
  disputeFlag        Boolean       @default(false)
  disputeNote        String?
  driverIncluded     Boolean       @default(true)
  childSeat          Boolean       @default(false)
  extraLuggage       Boolean       @default(false)
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  discountAmount     Decimal?          @db.Decimal(10, 2)
  deliveryType       DeliveryType      @default(NONE)
  deliveryAddress    String?
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  deliveryFee        Decimal           @default(0) @db.Decimal(10, 2)
  pickupAddress      String?
  pickupLatitude     Float?
  pickupLongitude    Float?
  pickupFee          Decimal           @default(0) @db.Decimal(10, 2)
  returnFee          Decimal           @default(0) @db.Decimal(10, 2)
  oneWayFee          Decimal           @default(0) @db.Decimal(10, 2)
  pickupHubId        String?
  returnHubId        String?
  pickupName         String?
  dropName           String?
  protectionPackageId String?
  protectionPackage  ProtectionPackage? @relation(fields: [protectionPackageId], references: [id], onDelete: SetNull)
  protectionCode     String?
  protectionFee      Decimal           @default(0) @db.Decimal(10, 2)
  protectionDeductible Decimal?        @db.Decimal(10, 2)
  walletDeduction    Decimal           @default(0) @db.Decimal(10, 2)
  // Mileage Package Pricing Snapshot
  mileagePackageId       String?
  mileagePackage         MileagePackage?   @relation(fields: [mileagePackageId], references: [id], onDelete: SetNull)
  mileagePackageName     String?
  includedKmPerDay       Int?
  includedKmTotal        Int?
  packageBasePricePerDay Decimal?          @db.Decimal(10, 2)
  extraKmRate            Decimal?          @db.Decimal(10, 2)
  pricingBasis           String            @default("LEGACY_DAILY")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  review             Review?
  payment            Payment?
  dispute            Dispute?
  inspections        Inspection[]
  handoverOtps       HandoverOtp[]
  securityDeposit    SecurityDeposit?
  damageClaims       DamageClaim[]
  couponUsage        CouponUsage?
  invoice            Invoice?
  creditNotes        CreditNote[]
  extensions         TripExtension[]
  additionalDrivers  AdditionalDriver[]
  supportTickets     SupportTicket[]
  emergencyRequests  EmergencyRequest[]
  attribution        BookingAttribution?
  outboxEvents       BookingOutboxEvent[]
  quoteId            String?
  quote              BookingQuote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  priceSnapshot      Json?
  vehicleClass       CarCategory?
  allocationStatus   String              @default("ALLOCATED")
  allocationStrategy String?             @default("EXACT_VEHICLE")
  allocationRecords  VehicleAllocationRecord[]
  checkoutSession    CheckoutSession?
  fulfillmentRecord  FulfillmentRecord?
  substitutionRecords VehicleSubstitutionRecord[]

  @@index([customerId])
  @@index([vendorId])
  @@index([carId])
  @@index([status])
  @@index([createdAt])
  @@index([mileagePackageId])
  @@index([carId, startDate, endDate, status])
  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@index([quoteId])
  @@index([allocationStatus])
  @@index([vehicleClass])
}

model MileagePackage {
  id               String    @id @default(cuid())
  carId            String
  car              Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  tripType         TripType
  name             String
  includedKmPerDay Int?      // null = Unlimited
  basePricePerDay  Decimal   @db.Decimal(10, 2)
  extraKmRate      Decimal   @default(0) @db.Decimal(10, 2)
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]

  @@index([carId])
  @@index([tripType])
  @@index([isActive])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  vendorId   String
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([vendorId])
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  WHATSAPP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
  DEAD_LETTER
}

enum NotificationPriority {
  HIGH
  NORMAL
  LOW
}

model Notification {
